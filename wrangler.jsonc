{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "endlls-studio",
  "compatibility_date": "2026-09-26",
  "workers_dev": true,
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "endlls.com", "custom_domain": true },
    { "pattern": "www.endlls.com", "custom_domain": true }
  ]
}
